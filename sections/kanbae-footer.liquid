{{ 'section-kanbae-footer.css' | asset_url | stylesheet_tag }}
{{ 'component-localization-form.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
    }
  }

  #KanbaeFooter-{{ section.id }} {
    --kb-ftr-heading-color: {{ section.settings.heading_color }};
    --kb-ftr-link-hover-color: {{ section.settings.link_hover_color }};
    --kb-ftr-divider-color: {{ section.settings.divider_color }};
    --kb-ftr-input-border: {{ section.settings.divider_color }};
    --kb-ftr-menu-count: {{ section.blocks.size | at_least: 1 | at_most: 5 }};
  }
{%- endstyle -%}

{%- liquid
  assign social_instagram = section.settings.social_instagram_link | default: settings.social_instagram_link
  assign social_tiktok = section.settings.social_tiktok_link | default: settings.social_tiktok_link
  assign social_youtube = section.settings.social_youtube_link | default: settings.social_youtube_link
  assign social_facebook = section.settings.social_facebook_link | default: settings.social_facebook_link
  assign social_twitter = section.settings.social_twitter_link | default: settings.social_twitter_link
  assign social_pinterest = section.settings.social_pinterest_link | default: settings.social_pinterest_link

  assign has_socials = false
  if social_instagram != blank or social_tiktok != blank or social_youtube != blank or social_facebook != blank or social_twitter != blank or social_pinterest != blank
    assign has_socials = true
  endif
-%}

<footer
  id="KanbaeFooter-{{ section.id }}"
  class="kb-ftr color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding"
>
  <div class="kb-ftr__page">
    <div class="kb-ftr__top">
      {%- if section.blocks.size > 0 -%}
        <div class="kb-ftr__menus">
          {%- for block in section.blocks -%}
            {%- if block.type == 'menu_column' -%}
              <div class="kb-ftr__menu-col" {{ block.shopify_attributes }}>
                <details class="kb-ftr__accordion" id="KbFooterMenu-{{ block.id }}">
                  <summary>
                    <h2 class="kb-ftr__heading">{{ block.settings.heading | escape }}</h2>
                    <span class="kb-ftr__accordion-icon" aria-hidden="true">
                      <svg viewBox="0 0 10 10" fill="none">
                        <path d="M5 0v10M0 5h10" stroke="currentColor" stroke-width="1"/>
                      </svg>
                    </span>
                  </summary>
                  {%- if block.settings.menu != blank -%}
                    <ul class="kb-ftr__menu-list">
                      {%- for link in block.settings.menu.links -%}
                        <li>
                          <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>
                            {{ link.title | escape }}
                          </a>
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </details>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="kb-ftr__connect">
        {%- if section.settings.newsletter_heading != blank -%}
          <h2 class="kb-ftr__connect-heading">{{ section.settings.newsletter_heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.newsletter_text != blank -%}
          <p class="kb-ftr__connect-text">{{ section.settings.newsletter_text | escape }}</p>
        {%- endif -%}

        {%- if section.settings.newsletter_enable -%}
          {%- assign kb_ftr_form_id = 'KbFooterNewsletter-' | append: section.id -%}
          {%- form 'customer', id: kb_ftr_form_id, class: 'kb-ftr__newsletter' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="kb-ftr__form">
              <input
                id="KbFooterEmail-{{ section.id }}"
                type="email"
                name="contact[email]"
                class="kb-ftr__input"
                value="{{ form.email }}"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                placeholder="{{ section.settings.input_placeholder | escape }}"
                aria-label="{{ section.settings.input_placeholder | escape }}"
                {% if form.errors %}
                  autofocus
                  aria-invalid="true"
                  aria-describedby="KbFooterError-{{ section.id }}"
                {% elsif form.posted_successfully? %}
                  aria-describedby="KbFooterSuccess-{{ section.id }}"
                {% endif %}
                required
              >
              <button type="submit" class="kb-ftr__submit" name="commit" aria-label="{{ section.settings.button_label | escape }}">
                <span class="svg-wrapper">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
              </button>
            </div>

            {%- if form.errors -%}
              <p class="kb-ftr__message kb-ftr__message--error form__message" id="KbFooterError-{{ section.id }}">
                <span class="svg-wrapper">{{- 'icon-error.svg' | inline_asset_content -}}</span>
                {{- form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email -}}
              </p>
            {%- endif -%}

            {%- if form.posted_successfully? -%}
              <p
                class="kb-ftr__message kb-ftr__message--success form__message"
                id="KbFooterSuccess-{{ section.id }}"
                tabindex="-1"
                autofocus
              >
                <span class="svg-wrapper">{{- 'icon-success.svg' | inline_asset_content -}}</span>
                {{- section.settings.success_message | escape -}}
              </p>
            {%- endif -%}

            {%- if section.settings.privacy_text != blank -%}
              <p class="kb-ftr__privacy">{{ section.settings.privacy_text | escape }}</p>
            {%- endif -%}
          {%- endform -%}
        {%- endif -%}

        {%- if has_socials -%}
          <ul class="kb-ftr__socials" role="list">
            {%- if social_instagram != blank -%}
              <li>
                <a href="{{ social_instagram }}" class="kb-ftr__social-link" aria-label="Instagram">
                  <span class="svg-wrapper">{{- 'icon-instagram.svg' | inline_asset_content -}}</span>
                </a>
              </li>
            {%- endif -%}
            {%- if social_tiktok != blank -%}
              <li>
                <a href="{{ social_tiktok }}" class="kb-ftr__social-link" aria-label="TikTok">
                  <span class="svg-wrapper">{{- 'icon-tiktok.svg' | inline_asset_content -}}</span>
                </a>
              </li>
            {%- endif -%}
            {%- if social_youtube != blank -%}
              <li>
                <a href="{{ social_youtube }}" class="kb-ftr__social-link" aria-label="YouTube">
                  <span class="svg-wrapper">{{- 'icon-youtube.svg' | inline_asset_content -}}</span>
                </a>
              </li>
            {%- endif -%}
            {%- if social_facebook != blank -%}
              <li>
                <a href="{{ social_facebook }}" class="kb-ftr__social-link" aria-label="Facebook">
                  <span class="svg-wrapper">{{- 'icon-facebook.svg' | inline_asset_content -}}</span>
                </a>
              </li>
            {%- endif -%}
            {%- if social_twitter != blank -%}
              <li>
                <a href="{{ social_twitter }}" class="kb-ftr__social-link" aria-label="X (Twitter)">
                  <span class="svg-wrapper">{{- 'icon-twitter.svg' | inline_asset_content -}}</span>
                </a>
              </li>
            {%- endif -%}
            {%- if social_pinterest != blank -%}
              <li>
                <a href="{{ social_pinterest }}" class="kb-ftr__social-link" aria-label="Pinterest">
                  <span class="svg-wrapper">{{- 'icon-pinterest.svg' | inline_asset_content -}}</span>
                </a>
              </li>
            {%- endif -%}
          </ul>
        {%- endif -%}
      </div>
    </div>

    <hr class="kb-ftr__divider">

    <div class="kb-ftr__legal">
      {%- if section.settings.disclaimer_text != blank -%}
        <p class="kb-ftr__disclaimer">{{ section.settings.disclaimer_text }}</p>
      {%- endif -%}
    </div>

    <div class="kb-ftr__bar">
      <div class="kb-ftr__bar-left">
        <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}. All rights reserved.</span>
        {%- if section.settings.show_policy -%}
          <ul class="kb-ftr__policies">
            {%- for policy in shop.policies -%}
              {%- if policy != blank -%}
                <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="kb-ftr__bar-right">
        {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
          <div class="kb-ftr__region">
            <span class="kb-ftr__region-icon" aria-hidden="true">
              <svg viewBox="0 0 20 20" fill="none">
                <circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="1"/>
                <path d="M2 10h16M10 2c2.2 2.2 3.4 5 3.4 8s-1.2 5.8-3.4 8c-2.2-2.2-3.4-5-3.4-8S7.8 4.2 10 2Z" stroke="currentColor" stroke-width="1"/>
              </svg>
            </span>
            <localization-form>
              {%- form 'localization', id: 'KbFooterCountryForm', class: 'localization-form' -%}
                <div>
                  <h2 class="visually-hidden" id="KbFooterCountryLabel">{{ 'localization.country_label' | t }}</h2>
                  {%- render 'country-localization', localPosition: 'KbFooterCountry' -%}
                </div>
              {%- endform -%}
            </localization-form>
          </div>
        {%- endif -%}

        {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
          <div class="kb-ftr__region">
            <localization-form>
              {%- form 'localization', id: 'KbFooterLanguageForm', class: 'localization-form' -%}
                <div>
                  <h2 class="visually-hidden" id="KbFooterLanguageLabel">{{ 'localization.language_label' | t }}</h2>
                  {%- render 'language-localization', localPosition: 'KbFooterLanguage' -%}
                </div>
              {%- endform -%}
            </localization-form>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Kanbae footer",
  "tag": "footer",
  "class": "section section-kanbae-footer",
  "blocks": [
    {
      "type": "menu_column",
      "name": "Menu column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Column heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer",
          "info": "Manage links from Online Store > Navigation."
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "newsletter_enable",
      "label": "Enable newsletter form",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Heading",
      "default": "Join Our Newsletter"
    },
    {
      "type": "textarea",
      "id": "newsletter_text",
      "label": "Description",
      "default": "Hangover science, early access to new drops, and morning-after tips — straight to your inbox."
    },
    {
      "type": "text",
      "id": "input_placeholder",
      "label": "Email input placeholder",
      "default": "Your email"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Submit button accessible label",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks for subscribing!"
    },
    {
      "type": "text",
      "id": "privacy_text",
      "label": "Privacy / incentive note",
      "default": "By subscribing you agree to our Privacy Policy. Unsubscribe anytime."
    },
    {
      "type": "header",
      "content": "Social links"
    },
    {
      "type": "paragraph",
      "content": "Leave blank to fall back to the links set in Theme settings > Social media."
    },
    {
      "type": "text",
      "id": "social_instagram_link",
      "label": "Instagram URL"
    },
    {
      "type": "text",
      "id": "social_tiktok_link",
      "label": "TikTok URL"
    },
    {
      "type": "text",
      "id": "social_youtube_link",
      "label": "YouTube URL"
    },
    {
      "type": "text",
      "id": "social_facebook_link",
      "label": "Facebook URL"
    },
    {
      "type": "text",
      "id": "social_twitter_link",
      "label": "X (Twitter) URL"
    },
    {
      "type": "text",
      "id": "social_pinterest_link",
      "label": "Pinterest URL"
    },
    {
      "type": "header",
      "content": "Legal & compliance"
    },
    {
      "type": "textarea",
      "id": "disclaimer_text",
      "label": "FDA / legal disclaimer",
      "default": "*These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease. Consult your physician before use if you are pregnant, nursing, taking medication, or have a medical condition. Kanbae products are intended for use by adults of legal drinking age and should not be used to encourage alcohol consumption."
    },
    {
      "type": "checkbox",
      "id": "show_policy",
      "label": "Show policy links",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "label": "Enable country/region selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "label": "Enable language selector",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Column heading color",
      "default": "#f7f6f2"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Link hover color",
      "default": "#c9a24b"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color",
      "default": "#4d5a4f"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "default": {
    "blocks": [
      { "type": "menu_column", "settings": { "heading": "Shop" } },
      { "type": "menu_column", "settings": { "heading": "Science & Formula" } },
      { "type": "menu_column", "settings": { "heading": "About Us" } },
      { "type": "menu_column", "settings": { "heading": "Support & Contact" } }
    ]
  }
}
{% endschema %}
